{
  "compilerOptions": {
    "target":          "ES2022",
    "module":          "commonjs",
    "lib":             ["ES2022"],
    "types":           ["node"],
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "baseUrl":         ".",
    "outDir":          "dist"
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "reports"]
}
